<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Edit household</h:title><model odk:xforms-version="1.0.0"><instance><data id="contact:carelink_household:edit" version="2026-10-22"><inputs><user><contact_id/></user></inputs><carelink_household><name/><external_id/><responsible_worker_id/><responsible_worker_name/><parent/><type>contact</type><contact_type>carelink_household</contact_type></carelink_household><meta><instanceID/></meta></data></instance><instance id="user-contact-summary"/>
<bind nodeset="/data/carelink_household/name" type="string" required="true()" constraint="string-length(normalize-space(.)) &gt;= 2" jr:constraintMsg="Enter the household name."/>
<bind nodeset="/data/carelink_household/external_id" type="string"/>
<bind nodeset="/data/carelink_household/responsible_worker_id" type="string" required="true()"/>
<bind nodeset="/data/carelink_household/responsible_worker_name" type="string" calculate="if(/data/carelink_household/responsible_worker_id = 'carelink-person-sabukari', 'Salamatu Abukari', '')"/>
<bind nodeset="/data/carelink_household/parent" type="string"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
</model></h:head><h:body><input ref="/data/carelink_household/name"><label>Household name</label><hint>Use the name the household is known by in the community.</hint></input><input ref="/data/carelink_household/external_id"><label>Household reference (optional)</label><hint>A house number or local reference helps avoid registering the same household twice.</hint></input><select1 ref="/data/carelink_household/responsible_worker_id"><label>Responsible CHO</label><hint>Change only if the facility has told you to.</hint><item><label>Salamatu Abukari (Tolon District Hospital)</label><value>carelink-person-sabukari</value></item></select1></h:body></h:html>
