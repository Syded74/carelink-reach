<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Add individual</h:title><model odk:xforms-version="1.0.0"><instance><data id="contact:carelink_individual:create" version="2026-10-21"><inputs><user><contact_id/></user></inputs><carelink_individual><name/><external_id/><parent/><type>contact</type><contact_type>carelink_individual</contact_type><care_stage/><sex_choice/><sex/><date_of_birth/><mother><_id/><name/><external_id/></mother><mother_id/><mother_external_id/><caregiver_name/><phone/><responsible_worker_id/></carelink_individual><meta><instanceID/></meta></data></instance><bind nodeset="/data/inputs/user/contact_id" type="string"/><bind nodeset="/data/inputs" relevant="0"/><bind nodeset="/data/carelink_individual/name" type="string" required="true()"/><bind nodeset="/data/carelink_individual/external_id" type="string"/><bind nodeset="/data/carelink_individual/parent" type="string"/><bind nodeset="/data/carelink_individual/type" type="string"/><bind nodeset="/data/carelink_individual/contact_type" type="string"/><bind nodeset="/data/carelink_individual/care_stage" type="string"/><bind nodeset="/data/carelink_individual/sex_choice" type="string" relevant="not(/data/carelink_individual/care_stage = 'anc' or /data/carelink_individual/care_stage = 'pnc')"/><bind nodeset="/data/carelink_individual/sex" type="string" calculate="if(/data/carelink_individual/care_stage = 'anc' or /data/carelink_individual/care_stage = 'pnc', 'F', /data/carelink_individual/sex_choice)"/><bind nodeset="/data/carelink_individual/date_of_birth" type="date" relevant="/data/carelink_individual/care_stage != ''"/><bind nodeset="/data/carelink_individual/mother/_id" type="string"/><bind nodeset="/data/carelink_individual/mother/name" type="string"/><bind nodeset="/data/carelink_individual/mother/external_id" type="string"/><bind nodeset="/data/carelink_individual/mother" relevant="/data/carelink_individual/care_stage = 'cwc'"/><bind nodeset="/data/carelink_individual/mother_id" type="string" calculate="/data/carelink_individual/mother/_id"/><bind nodeset="/data/carelink_individual/mother_external_id" type="string" calculate="/data/carelink_individual/mother/external_id"/><bind nodeset="/data/carelink_individual/caregiver_name" type="string" relevant="/data/carelink_individual/care_stage = 'cwc'"/><bind nodeset="/data/carelink_individual/phone" type="string" relevant="/data/carelink_individual/care_stage != ''"/><bind nodeset="/data/carelink_individual/responsible_worker_id" type="string" calculate="once(/data/inputs/user/contact_id)"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><group ref="/data/carelink_individual"><input ref="/data/carelink_individual/name"><label>Individual name</label></input><input ref="/data/carelink_individual/external_id"><label>Reference (avoid duplicate records)</label></input><select1 ref="/data/carelink_individual/care_stage"><label>Maternal and child care (optional)</label><hint>Leave empty for people who are not in ANC, PNC or child welfare care.</hint><item><label>Pregnant woman (ANC)</label><value>anc</value></item><item><label>Mother after delivery (PNC)</label><value>pnc</value></item><item><label>Child (child welfare)</label><value>cwc</value></item></select1><select1 ref="/data/carelink_individual/sex_choice"><label>Sex</label><item><label>Girl / female</label><value>F</value></item><item><label>Boy / male</label><value>M</value></item><item><label>Not recorded</label><value>not_recorded</value></item></select1><input ref="/data/carelink_individual/date_of_birth"><label>Date of birth</label></input><group ref="/data/carelink_individual/mother"><input ref="/data/carelink_individual/mother/_id" appearance="select-contact type-carelink_individual"><label>Mother (if registered)</label></input></group><input ref="/data/carelink_individual/caregiver_name"><label>Mother or caregiver name</label></input><input ref="/data/carelink_individual/phone"><label>Phone (optional)</label></input></group></h:body></h:html>
