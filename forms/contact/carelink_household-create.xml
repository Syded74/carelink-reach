<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Add household</h:title><model odk:xforms-version="1.0.0"><instance><data id="contact:carelink_household:create" version="2026-10-22"><inputs><user><contact_id/></user></inputs><responsible_worker_choice/><carelink_household><name/><external_id/><responsible_worker_id/><responsible_worker_name/><registered_by/><parent/><type>contact</type><contact_type>carelink_household</contact_type></carelink_household><meta><instanceID/></meta></data></instance><instance id="user-contact-summary"/>
<bind nodeset="/data/carelink_household/name" type="string" required="true()" constraint="string-length(normalize-space(.)) &gt;= 2" jr:constraintMsg="Enter the household name."/>
<bind nodeset="/data/carelink_household/external_id" type="string"/>
<bind nodeset="/data/responsible_worker_choice" type="string" required="(if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-tolon', 'carelink-person-sabukari', if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-gburimani', 'carelink-person-sabukari', if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-dimabi', 'carelink-person-sabukari', '')))) = ''" jr:requiredMsg="Choose the responsible CHO."/>
<bind nodeset="/data/carelink_household/responsible_worker_id" type="string" calculate="if(/data/responsible_worker_choice != '', /data/responsible_worker_choice, if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-tolon', 'carelink-person-sabukari', if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-gburimani', 'carelink-person-sabukari', if(instance('user-contact-summary')/context/carelink_facility_id = 'carelink-community-dimabi', 'carelink-person-sabukari', ''))))"/>
<bind nodeset="/data/carelink_household/registered_by" type="string" calculate="once(/data/inputs/user/contact_id)"/>
<bind nodeset="/data/carelink_household/responsible_worker_name" type="string" calculate="if(/data/carelink_household/responsible_worker_id = 'carelink-person-sabukari', 'Salamatu Abukari', '')"/>
<bind nodeset="/data/carelink_household/parent" type="string"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
</model></h:head><h:body><input ref="/data/carelink_household/name"><label>Household name</label><hint>Use the name the household is known by in the community.</hint></input><input ref="/data/carelink_household/external_id"><label>Household reference (optional)</label><hint>A house number or local reference helps avoid registering the same household twice.</hint></input><select1 ref="/data/responsible_worker_choice"><label>Responsible CHO (optional)</label><hint>Leave blank to use the CHO who covers your community. Choose only if the facility has told you to.</hint><item><label>Salamatu Abukari (Tolon District Hospital)</label><value>carelink-person-sabukari</value></item></select1></h:body></h:html>
