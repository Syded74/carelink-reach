<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Document outreach outcome</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_visit" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/><external_id/><responsible_worker_id/><responsible_worker_name/><parent><_id/><name/></parent></contact><user><contact_id/><name/></user><request_id/><expected_event/><current_status/><assigned_worker_id/><scheduled_date/><purpose/><barrier/><contact_method/><responsible_worker_id/><assignment_id/><proposal_id/></inputs><patient_id></patient_id><household_name tag="hidden"></household_name><community_name tag="hidden"></community_name><created_by tag="hidden"></created_by><actor></actor><assignment_id tag="hidden"></assignment_id><proposal_id tag="hidden"></proposal_id><request_id tag="hidden"></request_id><expected_event tag="hidden"></expected_event><current_status></current_status><assigned_worker_id tag="hidden"></assigned_worker_id><visit_date></visit_date><visit_type></visit_type><status></status><followup_required></followup_required><referral_recorded></referral_recorded><outcome_note></outcome_note><meta tag="hidden"><instanceID/></meta><notice tag="hidden"/></data></instance><bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/><bind nodeset="/data/household_name" type="string" calculate="/data/inputs/contact/name"/><bind nodeset="/data/community_name" type="string" calculate="/data/inputs/contact/parent/name"/><bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/><bind nodeset="/data/actor" type="string" required="true()" calculate="/data/inputs/user/name"/><bind nodeset="/data/assignment_id" type="string" calculate="/data/inputs/assignment_id"/><bind nodeset="/data/proposal_id" type="string" calculate="/data/inputs/proposal_id"/><bind nodeset="/data/request_id" type="string" required="true()" calculate="/data/inputs/request_id"/><bind nodeset="/data/expected_event" type="string" required="true()" calculate="/data/inputs/expected_event"/><bind nodeset="/data/current_status" type="string" required="true()" calculate="/data/inputs/current_status"/><bind nodeset="/data/assigned_worker_id" type="string" required="true()" calculate="/data/inputs/assigned_worker_id"/><bind nodeset="/data/visit_date" type="date" required="true()" constraint=". &lt;= today()" jr:constraintMsg="The visit date cannot be in the future."/><bind nodeset="/data/visit_type" type="string" required="true()"/><bind nodeset="/data/status" type="string" required="true()"/><bind nodeset="/data/followup_required" type="string" required="true()"/><bind nodeset="/data/referral_recorded" type="string" required="true()"/><bind nodeset="/data/outcome_note" type="string" required="true()" constraint="string-length(.) &lt;= 240" jr:constraintMsg="Check this value before saving."/><bind nodeset="/data/notice" readonly="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving a record does not confirm delivery. Check the CHT sync indicator. This is outreach coordination, not emergency care.</label></input><input ref="/data/visit_date"><label>Visit date</label></input><select1 ref="/data/visit_type"><label>Type of visit</label><item><label>Outreach contact</label><value>outreach_contact</value></item><item><label>Routine follow-up coordination</label><value>routine_followup</value></item></select1><select1 ref="/data/status"><label>What happened?</label><item><label>Visit occurred — documentation completed</label><value>completed</value></item><item><label>Visit could not be completed</label><value>unable_to_complete</value></item></select1><select1 ref="/data/followup_required"><label>Is further contact needed?</label><item><label>Yes</label><value>yes</value></item><item><label>No</label><value>no</value></item></select1><select1 ref="/data/referral_recorded"><label>Did an authorized professional record a referral separately?</label><item><label>No referral recorded</label><value>no</value></item><item><label>Referral recorded — receipt and acceptance not confirmed</label><value>yes</value></item></select1><input ref="/data/outcome_note"><label>Brief coordination outcome</label><hint>No clinical assessment, diagnoses or treatment advice in this form.</hint></input></h:body></h:html>