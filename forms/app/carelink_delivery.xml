<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Record delivery</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_delivery" version="2026-10-21"><inputs><source>user</source><source_id/><contact><_id/><name/><external_id/><care_stage/><sex/><date_of_birth/><mother_id/><responsible_worker_id/><parent><_id/></parent></contact><user><contact_id/><name/></user></inputs><patient_id/><patient_name tag="hidden"/><created_by tag="hidden"/><approval_status>pending_clinical_review</approval_status><notice tag="hidden"/><delivery_id tag="hidden"/><pregnancy_id tag="hidden"/><delivery_date/><children_note tag="hidden"/><children><child jr:template=""><_id/><name/></child></children><child_ids tag="hidden"/><meta tag="hidden"><instanceID/></meta></data></instance><instance id="contact-summary"/><bind nodeset="/data/inputs/source" type="string"/><bind nodeset="/data/inputs/source_id" type="string"/><bind nodeset="/data/inputs/contact/_id" type="string"/><bind nodeset="/data/inputs/contact/name" type="string"/><bind nodeset="/data/inputs/contact/external_id" type="string"/><bind nodeset="/data/inputs/contact/care_stage" type="string"/><bind nodeset="/data/inputs/contact/sex" type="string"/><bind nodeset="/data/inputs/contact/date_of_birth" type="string"/><bind nodeset="/data/inputs/contact/mother_id" type="string"/><bind nodeset="/data/inputs/contact/responsible_worker_id" type="string"/><bind nodeset="/data/inputs/contact/parent/_id" type="string"/><bind nodeset="/data/inputs/user/contact_id" type="string"/><bind nodeset="/data/inputs/user/name" type="string"/><bind nodeset="/data/inputs" relevant="0"/><bind nodeset="/data/patient_id" type="string" calculate="/data/inputs/contact/_id"/><bind nodeset="/data/patient_name" type="string" calculate="/data/inputs/contact/name"/><bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/><bind nodeset="/data/approval_status" type="string"/><bind nodeset="/data/notice" type="string" readonly="true()"/><bind nodeset="/data/delivery_id" type="string" calculate="once(uuid())"/><bind nodeset="/data/pregnancy_id" type="string" calculate="instance('contact-summary')/context/open_pregnancy_id"/><bind nodeset="/data/delivery_date" type="date" required="true()" constraint="instance('contact-summary')/context/open_pregnancy_id != ''" jr:constraintMsg="Record the pregnancy before the delivery."/><bind nodeset="/data/children_note" type="string" readonly="true()"/><bind nodeset="/data/children/child/_id" type="string" required="true()" constraint=". != /data/inputs/contact/_id" jr:constraintMsg="A child cannot be the mother."/><bind nodeset="/data/children/child/name" type="string"/><bind nodeset="/data/child_ids" type="string" calculate="join(' ', /data/children/child/_id)"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving does not confirm delivery: check the CHT sync indicator. Records only what you observed or did; CareLink adds no schedule, classification or threshold.</label></input><input ref="/data/delivery_date"><label>Delivery date</label></input><input ref="/data/children_note"><label>Register each newborn first (Add individual, care stage CWC, mother selected), then link them here.</label></input><group ref="/data/children"><label>Children from this delivery</label><group ref="/data/children/child"><label>Child</label><repeat nodeset="/data/children/child"><input ref="/data/children/child/_id" appearance="select-contact type-carelink_individual"><label>Child</label></input></repeat></group></group></h:body></h:html>
