<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Record the outreach day</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_oi_outreach_day" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/></contact><user><contact_id/><name/></user><assignment_id/><proposal_id/><planned_date/><items_planned/><route/><requests_planned/></inputs><patient_id/><actor/><actor_contact tag="hidden"/><assignment_id tag="hidden"/><proposal_id tag="hidden"/><outcome/><reason/><notice tag="hidden"/><meta tag="hidden"><instanceID/></meta></data></instance>
<bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/>
<bind nodeset="/data/actor" type="string" required="true()" calculate="/data/inputs/user/name"/>
<bind nodeset="/data/actor_contact" type="string" calculate="/data/inputs/user/contact_id"/>
<bind nodeset="/data/notice" readonly="true()"/>
<bind nodeset="/data/inputs/route" readonly="true()"/>
<bind nodeset="/data/inputs/requests_planned" readonly="true()"/>
<bind nodeset="/data/assignment_id" type="string" required="true()" calculate="/data/inputs/assignment_id"/>
<bind nodeset="/data/proposal_id" type="string" calculate="/data/inputs/proposal_id"/>
<bind nodeset="/data/outcome" type="string" required="true()"/>
<bind nodeset="/data/reason" type="string" relevant="/data/outcome != 'done'" required="true()" constraint="string-length(.) &lt;= 240"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving does not confirm delivery: the plan status changes only when the server acknowledges it. Danger signs follow referral procedures and never wait for a plan.</label></input><input ref="/data/inputs/route"><label>Planned for <output value="/data/inputs/planned_date"/>: <output value="/data/inputs/route"/> (<output value="/data/inputs/items_planned"/> routine items)</label></input><input ref="/data/inputs/requests_planned"><label>Household requests planned for this day: <output value="/data/inputs/requests_planned"/>. Record each household visit from its own task; this record does not close any request.</label></input><select1 ref="/data/outcome"><label>How did the outreach day go?</label><item><label>Outreach done as planned</label><value>done</value></item><item><label>Partly done</label><value>partly</value></item><item><label>Not done</label><value>not_done</value></item></select1><input ref="/data/reason"><label>What prevented it?</label><hint>Operational reason only, no clinical details.</hint></input></h:body></h:html>
