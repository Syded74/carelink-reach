<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Resource readiness</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_resource_status" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/></contact><user><contact_id/><name/></user></inputs><patient_id/><actor/><actor_contact tag="hidden"/><resource_id/><status/><quantity/><reserved/><verified_date/><note/><notice tag="hidden"/><meta tag="hidden"><instanceID/></meta></data></instance>
<bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/>
<bind nodeset="/data/actor" type="string" required="true()" calculate="/data/inputs/user/name"/>
<bind nodeset="/data/actor_contact" type="string" calculate="/data/inputs/user/contact_id"/>
<bind nodeset="/data/notice" readonly="true()"/>
<bind nodeset="/data/resource_id" type="string" required="true()"/>
<bind nodeset="/data/status" type="string" required="true()"/>
<bind nodeset="/data/quantity" type="decimal" relevant="selected('confirmed insufficient', /data/status)" required="true()" constraint=". &gt;= 0" jr:constraintMsg="Enter a quantity of 0 or more."/>
<bind nodeset="/data/reserved" type="decimal" relevant="selected('confirmed insufficient', /data/status)" constraint=". &gt;= 0 and . &lt;= /data/quantity" jr:constraintMsg="Reserved cannot exceed the quantity."/>
<bind nodeset="/data/verified_date" type="date" required="true()" jr:preload="date" jr:preloadParams="today" constraint=". &lt;= today()" jr:constraintMsg="The check cannot be in the future."/>
<bind nodeset="/data/note" type="string" constraint="string-length(.) &lt;= 240"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving does not confirm delivery: the plan status changes only when the server acknowledges it. Danger signs follow referral procedures and never wait for a plan.</label></input><select1 ref="/data/resource_id"><label>Resource</label><hint>Planning resources configured for the facility. Vaccine stock is recorded here but is not tied to any visit type without reviewed clinical configuration.</hint><item><label>Child weighing scale and length/height board (outreach set) (set)</label><value>growth-measurement-set</value></item><item><label>Blood pressure monitor (device)</label><value>bp-monitor</value></item><item><label>ANC outreach supplies (pack)</label><value>anc-outreach-supplies</value></item><item><label>PNC outreach supplies (pack)</label><value>pnc-outreach-supplies</value></item><item><label>Child welfare outreach supplies (pack)</label><value>cwc-outreach-supplies</value></item><item><label>Motorbike fuel (litres)</label><value>motorbike-fuel</value></item><item><label>Pentavalent vaccine stock (entered by authorised staff) (dose)</label><value>vaccine-stock-penta</value></item></select1><select1 ref="/data/status"><label>Status</label><hint>Needs confirmation is never treated as available.</hint><item><label>Available</label><value>confirmed</value></item><item><label>Not enough</label><value>insufficient</value></item><item><label>Not available</label><value>unavailable</value></item><item><label>Needs confirmation (could not check)</label><value>unknown</value></item></select1><input ref="/data/quantity"><label>Quantity on hand</label><hint>In the unit shown with the resource.</hint></input><input ref="/data/reserved"><label>Already reserved for other work (optional)</label></input><input ref="/data/verified_date"><label>Date checked</label></input><input ref="/data/note"><label>Note (optional)</label></input></h:body></h:html>
