<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Review or update request</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_coordination" version="2026-10-21"><inputs><source>user</source><source_id/><contact><_id/><name/><external_id/><responsible_worker_id/><responsible_worker_name/><parent><_id/><name/></parent></contact><user><contact_id/><name/></user><request_id/><expected_event/><current_status/><assigned_worker_id/><scheduled_date/><purpose/><barrier/><contact_method/><responsible_worker_id/></inputs><patient_id></patient_id><household_name tag="hidden"></household_name><community_name tag="hidden"></community_name><created_by tag="hidden"></created_by><request_id tag="hidden"></request_id><expected_event tag="hidden"></expected_event><current_status></current_status><status></status><assigned_worker_id tag="hidden"></assigned_worker_id><assigned_worker_name></assigned_worker_name><scheduled_date></scheduled_date><outcome_note></outcome_note><meta tag="hidden"><instanceID/></meta><notice tag="hidden"/></data></instance><bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/><bind nodeset="/data/household_name" type="string" calculate="/data/inputs/contact/name"/><bind nodeset="/data/community_name" type="string" calculate="/data/inputs/contact/parent/name"/><bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/><bind nodeset="/data/request_id" type="string" required="true()" calculate="/data/inputs/request_id"/><bind nodeset="/data/expected_event" type="string" required="true()" calculate="/data/inputs/expected_event"/><bind nodeset="/data/current_status" type="string" required="true()" calculate="/data/inputs/current_status"/><bind nodeset="/data/status" type="string" required="true()" constraint="(/data/current_status = 'awaiting_assignment' and (. = 'accepted' or . = 'cancelled')) or ((/data/current_status = 'accepted' or /data/current_status = 'contact_attempt') and (. = 'assigned' or . = 'contact_attempt' or . = 'cancelled')) or (/data/current_status = 'assigned' and (. = 'scheduled' or . = 'contact_attempt' or . = 'cancelled')) or ((/data/current_status = 'scheduled' or /data/current_status = 'in_progress') and (. = 'in_progress' or . = 'cancelled' or . = 'unable_to_complete'))" jr:constraintMsg="This step does not follow the current state. Accept, assign, then confirm the schedule in separate records."/><bind nodeset="/data/assigned_worker_name" type="string" calculate="if(/data/assigned_worker_id != '', jr:choice-name(/data/assigned_worker_id, '/data/assigned_worker_id'), '')"/><bind nodeset="/data/assigned_worker_id" type="string" required="true()" constraint=". = /data/inputs/responsible_worker_id" relevant=". != 'unused' and (/data/status = 'assigned' or /data/status = 'scheduled' or /data/status = 'in_progress')" jr:constraintMsg="Choose the worker responsible for this household. Coverage changes require an administrator."/><bind nodeset="/data/scheduled_date" type="date" required="true()" constraint=". &gt;= today()" relevant="/data/status = 'scheduled' or /data/status = 'in_progress'" jr:constraintMsg="Choose today or a future date."/><bind nodeset="/data/outcome_note" type="string" required="true()" constraint="string-length(.) &lt;= 240" jr:constraintMsg="Check this value before saving."/><bind nodeset="/data/notice" readonly="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving a record does not confirm delivery. Check the CHT sync indicator. This is outreach coordination, not emergency care.</label></input><select1 ref="/data/status"><label>Record the next coordination step</label><item><label>Accept for coordination</label><value>accepted</value></item><item><label>Assign responsible health worker</label><value>assigned</value></item><item><label>Confirm outreach date</label><value>scheduled</value></item><item><label>Contact attempt unsuccessful</label><value>contact_attempt</value></item><item><label>Visit in progress — worker has confirmed</label><value>in_progress</value></item><item><label>Unable to complete</label><value>unable_to_complete</value></item><item><label>Cancel request</label><value>cancelled</value></item></select1><select1 ref="/data/assigned_worker_id"><label>Responsible worker</label><item><label>Salamatu Abukari (Tolon District Hospital)</label><value>carelink-person-sabukari</value></item></select1><input ref="/data/scheduled_date"><label>Confirmed outreach date</label></input><input ref="/data/outcome_note"><label>Coordination outcome or unsuccessful contact details</label><hint>Use a brief operational note. Do not include clinical details.</hint></input></h:body></h:html>