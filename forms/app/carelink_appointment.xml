<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Appointment</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_appointment" version="2026-10-21"><inputs><source>user</source><source_id/><appointment_id/><expected_event/><current_state/><due_date/><contact><_id/><name/><external_id/><care_stage/><sex/><date_of_birth/><mother_id/><responsible_worker_id/><parent><_id/></parent></contact><user><contact_id/><name/></user></inputs><patient_id/><patient_name tag="hidden"/><created_by tag="hidden"/><approval_status>pending_clinical_review</approval_status><notice tag="hidden"/><existing_id tag="hidden"/><existing_event tag="hidden"/><existing_state tag="hidden"/><existing_due tag="hidden"/><mode/><current tag="hidden"/><next_state tag="hidden"/><new_due/><due_date/><actor/><new_id tag="hidden"/><appointment_id tag="hidden"/><expected_event tag="hidden"/><state/><note/><meta tag="hidden"><instanceID/></meta></data></instance><instance id="contact-summary"/><bind nodeset="/data/inputs/source" type="string"/><bind nodeset="/data/inputs/source_id" type="string"/><bind nodeset="/data/inputs/appointment_id" type="string"/><bind nodeset="/data/inputs/expected_event" type="string"/><bind nodeset="/data/inputs/current_state" type="string"/><bind nodeset="/data/inputs/due_date" type="string"/><bind nodeset="/data/inputs/contact/_id" type="string"/><bind nodeset="/data/inputs/contact/name" type="string"/><bind nodeset="/data/inputs/contact/external_id" type="string"/><bind nodeset="/data/inputs/contact/care_stage" type="string"/><bind nodeset="/data/inputs/contact/sex" type="string"/><bind nodeset="/data/inputs/contact/date_of_birth" type="string"/><bind nodeset="/data/inputs/contact/mother_id" type="string"/><bind nodeset="/data/inputs/contact/responsible_worker_id" type="string"/><bind nodeset="/data/inputs/contact/parent/_id" type="string"/><bind nodeset="/data/inputs/user/contact_id" type="string"/><bind nodeset="/data/inputs/user/name" type="string"/><bind nodeset="/data/inputs" relevant="0"/><bind nodeset="/data/patient_id" type="string" calculate="/data/inputs/contact/_id"/><bind nodeset="/data/patient_name" type="string" calculate="/data/inputs/contact/name"/><bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/><bind nodeset="/data/approval_status" type="string"/><bind nodeset="/data/notice" type="string" readonly="true()"/><bind nodeset="/data/existing_id" type="string" calculate="if(/data/inputs/appointment_id != '', /data/inputs/appointment_id, instance('contact-summary')/context/open_appointment_id)"/><bind nodeset="/data/existing_event" type="string" calculate="if(/data/inputs/appointment_id != '', /data/inputs/expected_event, instance('contact-summary')/context/open_appointment_event)"/><bind nodeset="/data/existing_state" type="string" calculate="if(/data/inputs/appointment_id != '', /data/inputs/current_state, instance('contact-summary')/context/open_appointment_state)"/><bind nodeset="/data/existing_due" type="string" calculate="if(/data/inputs/appointment_id != '', /data/inputs/due_date, instance('contact-summary')/context/open_appointment_due)"/><bind nodeset="/data/mode" type="string" required="true()" constraint=". = 'new' or /data/existing_id != ''" jr:constraintMsg="There is no open record to update."/><bind nodeset="/data/current" type="string" relevant="/data/mode = 'update'" readonly="true()"/><bind nodeset="/data/next_state" type="string" required="true()" relevant="/data/mode = 'update'" constraint="(/data/existing_state = 'scheduled' and selected('attended missed rescheduled cancelled', .)) or (/data/existing_state = 'missed' and selected('rescheduled cancelled', .)) or (/data/existing_state = 'rescheduled' and selected('attended missed rescheduled cancelled', .))" jr:constraintMsg="This change is not allowed from the current state."/><bind nodeset="/data/new_due" type="date" required="true()" relevant="/data/mode = 'new' or /data/next_state = 'rescheduled'" constraint="/data/mode = 'new' or . != /data/existing_due" jr:constraintMsg="A reschedule must change the date."/><bind nodeset="/data/due_date" type="string" calculate="if(/data/mode = 'new' or /data/next_state = 'rescheduled', /data/new_due, /data/existing_due)"/><bind nodeset="/data/actor" type="string" calculate="/data/inputs/user/name"/><bind nodeset="/data/new_id" type="string" calculate="once(uuid())"/><bind nodeset="/data/appointment_id" type="string" calculate="if(/data/mode = 'new', /data/new_id, /data/existing_id)"/><bind nodeset="/data/expected_event" type="string" calculate="if(/data/mode = 'new', '', /data/existing_event)"/><bind nodeset="/data/state" type="string" calculate="if(/data/mode = 'new', 'scheduled', /data/next_state)"/><bind nodeset="/data/note" type="string"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving does not confirm delivery: check the CHT sync indicator. Records only what you observed or did; CareLink adds no schedule, classification or threshold.</label></input><select1 ref="/data/mode"><label>What are you recording?</label><item><label>Start a new appointment</label><value>new</value></item><item><label>Update the open appointment</label><value>update</value></item></select1><input ref="/data/current"><label>Current state: <output value="/data/existing_state"/></label></input><select1 ref="/data/next_state"><label>What happened?</label><item><label>Attended</label><value>attended</value></item><item><label>Missed (recorded by you)</label><value>missed</value></item><item><label>Rescheduled</label><value>rescheduled</value></item><item><label>Cancelled</label><value>cancelled</value></item></select1><input ref="/data/new_due"><label>Appointment date</label></input><input ref="/data/note"><label>Note (optional)</label></input></h:body></h:html>
