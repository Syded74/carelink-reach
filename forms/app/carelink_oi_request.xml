<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Generate outreach plan</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_oi_request" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/></contact><user><contact_id/><name/></user></inputs><patient_id/><actor/><actor_contact tag="hidden"/><suggested_date tag="hidden"/><outreach_weekday tag="hidden"/><suggested_note tag="hidden"/><planning_date/><off_schedule_note tag="hidden"/><season/><staff_available_f1/><staff_available/><hours_start/><hours_end/><vehicles_f1/><vehicles_f2/><vehicles_f3/><vehicles_f4/><vehicles/><use_synthetic_history/><fairness_weight/><guarantee_communities_f1/><guarantee_communities_f2/><guarantee_communities_f3/><guarantee_communities_f4/><guarantee_communities/><notice tag="hidden"/><meta tag="hidden"><instanceID/></meta></data></instance>
<bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/>
<bind nodeset="/data/actor" type="string" required="true()" calculate="/data/inputs/user/name"/>
<bind nodeset="/data/actor_contact" type="string" calculate="/data/inputs/user/contact_id"/>
<bind nodeset="/data/notice" readonly="true()"/>
<bind nodeset="/data/planning_date" type="date" required="true()" constraint=". &gt;= today()" jr:constraintMsg="Choose today or a later date."/>
<bind nodeset="/data/suggested_date" type="string" calculate="if(/data/inputs/contact/_id = 'carelink-facility-kpendua', format-date(date(floor(decimal-date-time(today()) + 0.5) + ((2 - ((floor(decimal-date-time(today()) + 0.5) + 4) mod 7) + 7) mod 7)), '%Y-%m-%d'), if(/data/inputs/contact/_id = 'carelink-facility-wantugu', format-date(date(floor(decimal-date-time(today()) + 0.5) + ((2 - ((floor(decimal-date-time(today()) + 0.5) + 4) mod 7) + 7) mod 7)), '%Y-%m-%d'), if(/data/inputs/contact/_id = 'carelink-facility-nyankpala', format-date(date(floor(decimal-date-time(today()) + 0.5) + ((2 - ((floor(decimal-date-time(today()) + 0.5) + 4) mod 7) + 7) mod 7)), '%Y-%m-%d'), if(/data/inputs/contact/_id = 'carelink-facility-tolon-hospital', format-date(date(floor(decimal-date-time(today()) + 0.5) + ((2 - ((floor(decimal-date-time(today()) + 0.5) + 4) mod 7) + 7) mod 7)), '%Y-%m-%d'), format-date(date(floor(decimal-date-time(today()) + 0.5) + ((2 - ((floor(decimal-date-time(today()) + 0.5) + 4) mod 7) + 7) mod 7)), '%Y-%m-%d')))))"/>
<bind nodeset="/data/outreach_weekday" type="string" calculate="if(/data/inputs/contact/_id = 'carelink-facility-kpendua', 2, if(/data/inputs/contact/_id = 'carelink-facility-wantugu', 2, if(/data/inputs/contact/_id = 'carelink-facility-nyankpala', 2, if(/data/inputs/contact/_id = 'carelink-facility-tolon-hospital', 2, -1))))"/>
<bind nodeset="/data/suggested_note" readonly="true()" relevant="/data/suggested_date != ''"/>
<bind nodeset="/data/off_schedule_note" readonly="true()" relevant="/data/planning_date != '' and /data/outreach_weekday &gt;= 0 and ((floor(decimal-date-time(/data/planning_date) + 0.5) + 4) mod 7) != /data/outreach_weekday"/>
<bind nodeset="/data/season" type="string" required="true()"/>
<bind nodeset="/data/staff_available_f1" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-tolon-hospital'" required="true()"/>
<bind nodeset="/data/staff_available" type="string" calculate="normalize-space(/data/staff_available_f1)" required="true()"/>
<bind nodeset="/data/hours_start" type="string" required="true()"/>
<bind nodeset="/data/hours_end" type="string" required="true()" constraint="number(.) &gt; number(/data/hours_start)" jr:constraintMsg="The working day must end after it starts."/>
<bind nodeset="/data/vehicles_f1" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-tolon-hospital'"/>
<bind nodeset="/data/vehicles_f2" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-nyankpala'"/>
<bind nodeset="/data/vehicles_f3" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-wantugu'"/>
<bind nodeset="/data/vehicles_f4" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-kpendua'"/>
<bind nodeset="/data/vehicles" type="string" calculate="normalize-space(concat(/data/vehicles_f1, ' ', /data/vehicles_f2, ' ', /data/vehicles_f3, ' ', /data/vehicles_f4))"/>
<bind nodeset="/data/use_synthetic_history" type="string" required="true()"/>
<bind nodeset="/data/fairness_weight" type="decimal" required="true()" constraint=". &gt;= 0 and . &lt;= 1" jr:constraintMsg="Use a value from 0 to 1."/>
<bind nodeset="/data/guarantee_communities_f1" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-tolon-hospital'"/>
<bind nodeset="/data/guarantee_communities_f2" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-nyankpala'"/>
<bind nodeset="/data/guarantee_communities_f3" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-wantugu'"/>
<bind nodeset="/data/guarantee_communities_f4" type="string" relevant="/data/inputs/contact/_id = 'carelink-facility-kpendua'"/>
<bind nodeset="/data/guarantee_communities" type="string" calculate="normalize-space(concat(/data/guarantee_communities_f1, ' ', /data/guarantee_communities_f2, ' ', /data/guarantee_communities_f3, ' ', /data/guarantee_communities_f4))"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving does not confirm delivery: the plan status changes only when the server acknowledges it. Danger signs follow referral procedures and never wait for a plan.</label></input><input ref="/data/suggested_note"><label>This facility's next scheduled outreach day is <output value="/data/suggested_date"/>.</label></input><input ref="/data/planning_date"><label>Outreach date</label><hint>Usually the scheduled outreach day above. You can choose another date.</hint></input><input ref="/data/off_schedule_note"><label>This date is not the facility's usual outreach day. You can continue; the plan will show a calendar warning.</label></input><select1 ref="/data/season"><label>Travel times to use</label><hint>Estimated travel times from planning/tolon-district.json; confirm them with the facility.</hint><item><label>Dry season</label><value>dry</value></item><item><label>Rainy season</label><value>rainy</value></item></select1><select ref="/data/staff_available_f1"><label>Health workers available that day</label><item><label>Salamatu Abukari (CHO)</label><value>carelink-person-sabukari</value></item></select><select1 ref="/data/hours_start"><label>Working day starts</label><item><label>06:00</label><value>0600</value></item><item><label>07:00</label><value>0700</value></item><item><label>08:00</label><value>0800</value></item><item><label>09:00</label><value>0900</value></item><item><label>10:00</label><value>1000</value></item><item><label>11:00</label><value>1100</value></item><item><label>12:00</label><value>1200</value></item><item><label>13:00</label><value>1300</value></item><item><label>14:00</label><value>1400</value></item><item><label>15:00</label><value>1500</value></item><item><label>16:00</label><value>1600</value></item><item><label>17:00</label><value>1700</value></item><item><label>18:00</label><value>1800</value></item></select1><select1 ref="/data/hours_end"><label>Working day ends</label><item><label>06:00</label><value>0600</value></item><item><label>07:00</label><value>0700</value></item><item><label>08:00</label><value>0800</value></item><item><label>09:00</label><value>0900</value></item><item><label>10:00</label><value>1000</value></item><item><label>11:00</label><value>1100</value></item><item><label>12:00</label><value>1200</value></item><item><label>13:00</label><value>1300</value></item><item><label>14:00</label><value>1400</value></item><item><label>15:00</label><value>1500</value></item><item><label>16:00</label><value>1600</value></item><item><label>17:00</label><value>1700</value></item><item><label>18:00</label><value>1800</value></item></select1><select ref="/data/vehicles_f1"><label>Vehicles available that day</label><hint>Every trip needs a vehicle. Leave all unticked if none is available.</hint><item><label>Hospital outreach motorbike 1</label><value>carelink-facility-tolon-hospital-motorbike-1</value></item><item><label>Hospital outreach motorbike 2</label><value>carelink-facility-tolon-hospital-motorbike-2</value></item></select><select ref="/data/vehicles_f2"><label>Vehicles available that day</label><hint>Every trip needs a vehicle. Leave all unticked if none is available.</hint><item><label>Health centre motorbike</label><value>carelink-facility-nyankpala-motorbike-1</value></item></select><select ref="/data/vehicles_f3"><label>Vehicles available that day</label><hint>Every trip needs a vehicle. Leave all unticked if none is available.</hint><item><label>Health centre motorbike</label><value>carelink-facility-wantugu-motorbike-1</value></item></select><select ref="/data/vehicles_f4"><label>Vehicles available that day</label><hint>Every trip needs a vehicle. Leave all unticked if none is available.</hint><item><label>CHPS motorbike</label><value>carelink-facility-kpendua-motorbike-1</value></item></select><select1 ref="/data/use_synthetic_history"><label>Forecast history</label><item><label>Live CHT counts only</label><value>no</value></item><item><label>Live CHT counts + simulated past weeks (for testing the forecast)</label><value>yes</value></item></select1><input ref="/data/fairness_weight"><label>Fairness weight (0–1)</label><hint>Raises the priority of communities with transport barriers or few reported weeks. Low reporting can mean poor access, not low need.</hint></input><select ref="/data/guarantee_communities_f1"><label>Guarantee a visit to (optional, hard constraint)</label><item><label>Tolon</label><value>carelink-community-tolon</value></item><item><label>Gburimani</label><value>carelink-community-gburimani</value></item><item><label>Dimabi</label><value>carelink-community-dimabi</value></item></select><select ref="/data/guarantee_communities_f2"><label>Guarantee a visit to (optional, hard constraint)</label><item><label>Nyankpala</label><value>carelink-community-nyankpala</value></item><item><label>Gbulahegu</label><value>carelink-community-gbulahegu</value></item><item><label>Tingoli</label><value>carelink-community-tingoli</value></item><item><label>Tunayili</label><value>carelink-community-tunayili</value></item></select><select ref="/data/guarantee_communities_f3"><label>Guarantee a visit to (optional, hard constraint)</label><item><label>Wantugu</label><value>carelink-community-wantugu</value></item><item><label>Lingbun Gudaa</label><value>carelink-community-lingbun-gudaa</value></item></select><select ref="/data/guarantee_communities_f4"><label>Guarantee a visit to (optional, hard constraint)</label><item><label>Kpendua</label><value>carelink-community-kpendua</value></item><item><label>Chirifoyili</label><value>carelink-community-chirifoyili</value></item><item><label>Tali</label><value>carelink-community-tali</value></item></select></h:body></h:html>
