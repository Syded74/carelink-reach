<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Request help</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_request" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/><external_id/><responsible_worker_id/><responsible_worker_name/><parent><_id/><name/></parent></contact><user><contact_id/><name/></user><request_id/><expected_event/><current_status/><assigned_worker_id/><scheduled_date/><purpose/><barrier/><contact_method/><responsible_worker_id/></inputs><patient_id></patient_id><household_name tag="hidden"></household_name><community_name tag="hidden"></community_name><created_by tag="hidden"></created_by><consent></consent><care_need></care_need><followup_type></followup_type><contact_method></contact_method><access_barrier></access_barrier><travel_time></travel_time><meta tag="hidden"><instanceID/></meta><notice tag="hidden"/></data></instance><instance id="contact-summary"/><bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/><bind nodeset="/data/household_name" type="string" calculate="/data/inputs/contact/name"/><bind nodeset="/data/community_name" type="string" calculate="/data/inputs/contact/parent/name"/><bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/><bind nodeset="/data/consent" type="string" required="true()" constraint=". = 'yes'" jr:constraintMsg="Consent is needed to submit a contact request. If consent is not given, close this form without saving."/><bind nodeset="/data/care_need" type="string" required="true()"/><bind nodeset="/data/followup_type" type="string" required="true()"/><bind nodeset="/data/contact_method" type="string" required="true()"/><bind nodeset="/data/access_barrier" type="string" required="true()"/><bind nodeset="/data/travel_time" type="string" required="true()" relevant="selected('distance transport_unavailable transport_cost', /data/access_barrier)"/><bind nodeset="/data/notice" readonly="true()"/><bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/></model></h:head><h:body><input ref="/data/notice"><label>Use this to report a routine need from the household. You do not need to assess anyone's health. Urgent or serious concern? Contact the CHO or the facility directly now; do not wait for a request or an outreach day. Saving does not confirm delivery: check the sync indicator.</label></input><select1 ref="/data/consent"><label>May a health worker contact this household?</label><item><label>Yes</label><value>yes</value></item><item><label>No</label><value>no</value></item></select1><select1 ref="/data/care_need"><label>Which routine service does the household want help with?</label><hint>Choose the service the household asks for. This is not an assessment of anyone's health.</hint><item><label>Antenatal care (pregnancy check-ups)</label><value>antenatal_care</value></item><item><label>Postnatal care (mother and newborn after birth)</label><value>postnatal_care</value></item><item><label>Child welfare clinic (growth monitoring, immunisation)</label><value>child_welfare</value></item><item><label>Family planning</label><value>family_planning</value></item><item><label>General health-worker visit</label><value>general_visit</value></item><item><label>Other routine service</label><value>other_routine</value></item></select1><select1 ref="/data/followup_type"><label>What would you like help with?</label><item><label>Request a health-worker visit</label><value>visit</value></item><item><label>Ask about a scheduled outreach visit</label><value>schedule_question</value></item><item><label>Request follow-up on an existing visit</label><value>followup</value></item></select1><select1 ref="/data/contact_method"><label>How should the worker contact the household?</label><item><label>Through the community contact</label><value>community_contact</value></item><item><label>At the household during an agreed visit</label><value>in_person</value></item></select1><select1 ref="/data/access_barrier"><label>Is anything making access difficult?</label><item><label>Distance to facility</label><value>distance</value></item><item><label>Transport unavailable</label><value>transport_unavailable</value></item><item><label>Transport cost</label><value>transport_cost</value></item><item><label>Household decision-making difficulty</label><value>household_decision</value></item><item><label>Language or communication barrier</label><value>language</value></item><item><label>Other reason</label><value>other</value></item><item><label>Prefer not to answer</label><value>prefer_not</value></item><item><label>No barrier reported</label><value>none</value></item></select1><select1 ref="/data/travel_time"><label>About how long does it take the household to reach the facility?</label><item><label>Under 30 minutes</label><value>under_30</value></item><item><label>30 minutes to 1 hour</label><value>30_to_60</value></item><item><label>More than 1 hour</label><value>over_60</value></item><item><label>Not known</label><value>unknown</value></item></select1></h:body></h:html>