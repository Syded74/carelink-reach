<?xml version="1.0"?>
<h:html xmlns="http://www.w3.org/2002/xforms" xmlns:h="http://www.w3.org/1999/xhtml" xmlns:jr="http://openrosa.org/javarosa" xmlns:odk="http://www.opendatakit.org/xforms"><h:head><h:title>Record household contact</h:title><model odk:xforms-version="1.0.0"><instance><data id="carelink_household_contact" version="2026-10-22"><inputs><source>user</source><source_id/><contact><_id/><name/><parent><_id/><name/></parent></contact><user><contact_id/><name/></user></inputs><patient_id/><household_name tag="hidden"/><community_name tag="hidden"/><created_by tag="hidden"/><request_id tag="hidden"/><contact_date/><outcome/><note/><notice tag="hidden"/><meta tag="hidden"><instanceID/></meta></data></instance><instance id="contact-summary"/>
<bind nodeset="/data/patient_id" type="string" required="true()" calculate="/data/inputs/contact/_id"/>
<bind nodeset="/data/household_name" type="string" calculate="/data/inputs/contact/name"/>
<bind nodeset="/data/community_name" type="string" calculate="/data/inputs/contact/parent/name"/>
<bind nodeset="/data/created_by" type="string" calculate="/data/inputs/user/contact_id"/>
<bind nodeset="/data/request_id" type="string" required="true()" calculate="instance('contact-summary')/context/latest_open_request_id"/>
<bind nodeset="/data/contact_date" type="date" required="true()" jr:preload="date" jr:preloadParams="today" constraint=". &lt;= today()" jr:constraintMsg="The contact date cannot be in the future."/>
<bind nodeset="/data/outcome" type="string" required="true()"/>
<bind nodeset="/data/note" type="string" required="/data/outcome = 'other'" constraint="string-length(.) &lt;= 240" jr:constraintMsg="Keep the note under 240 characters."/>
<bind nodeset="/data/notice" readonly="true()"/>
<bind nodeset="/data/meta/instanceID" type="string" readonly="true()" jr:preload="uid"/>
</model></h:head><h:body><input ref="/data/notice"><label>CareLink Reach. Saving a record does not confirm delivery. Check the CHT sync indicator. This is outreach coordination, not emergency care: anyone with danger signs follows referral procedures now and never waits for a request.</label></input><input ref="/data/contact_date"><label>When did you contact the household?</label></input><select1 ref="/data/outcome"><label>What happened?</label><item><label>Told the household about a planned or confirmed visit</label><value>informed_of_visit</value></item><item><label>Reached the household; nothing new to report</label><value>reached_no_update</value></item><item><label>Could not reach the household</label><value>not_reached</value></item><item><label>The household says help is no longer needed</label><value>no_longer_needed</value></item><item><label>The household has moved away</label><value>moved</value></item><item><label>Other</label><value>other</value></item></select1><input ref="/data/note"><label>Note for the facility</label><hint>Non-clinical only: no symptoms, diagnoses or treatment details. The facility decides any change to the request.</hint></input></h:body></h:html>
