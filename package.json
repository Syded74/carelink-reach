{
  "name": "carelink-reach-config",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "CareLink Reach: AI-assisted community outreach planning on the Community Health Toolkit (CHT 5.3), generated demonstration data",
  "scripts": {
    "pretest": "node scripts/cht.js compile-app-settings",
    "test": "node --test test/*.test.js",
    "build-report-labels": "node scripts/build-report-labels.js",
    "usability-screens": "node scripts/usability-screens.js",
    "outreach-screens": "node scripts/outreach-screens.js",
    "outreach-phone": "node scripts/outreach-phone.js",
    "cleanup-inventory": "node scripts/cleanup-inventory.js",
    "compile": "node scripts/cht.js compile-app-settings",
    "deploy": "node scripts/build-report-labels.js && node scripts/cht.js compile-app-settings upload-app-settings upload-resources upload-custom-translations upload-app-forms upload-contact-forms upload-ui-extensions",
    "seed": "node scripts/seed.js",
    "cleanup": "node scripts/seed.js --cleanup",
    "setup-accounts": "node scripts/setup-accounts.js",
    "backup": "node scripts/backup.js",
    "verify": "node scripts/verify-live.js",
    "deploy-authority": "node scripts/deploy-authority.js",
    "check-access": "node scripts/check-access.js",
    "build-forms": "node scripts/build-mch-forms.js && node scripts/build-report-labels.js",
    "mch-flow": "node scripts/mch-flow.js",
    "volunteer-flow": "node scripts/volunteer-flow.js",
    "plan": "node scripts/plan-outreach.js",
    "oi-export": "node scripts/export-oi-aggregates.js",
    "build-oi-forms": "node scripts/build-oi-forms.js && node scripts/build-report-labels.js",
    "build-oi-extension": "node scripts/build-oi-extension.js",
    "build-volunteer-forms": "node scripts/build-volunteer-forms.js && node scripts/build-report-labels.js",
    "oi-setup": "node scripts/oi-setup.js",
    "oi-worker": "cd outreach-intelligence && .venv/bin/python -m carelink_oi.cht_integration",
    "oi-cht-flow": "node scripts/oi-cht-flow.js",
    "feedback-flow": "node scripts/feedback-flow.js",
    "mch-outreach-flow": "node scripts/mch-outreach-flow.js",
    "android-device-flow": "node scripts/android-device-flow.js",
    "android-roles-flow": "node scripts/android-roles-flow.js",
    "walkthrough-flow": "node scripts/walkthrough-flow.js",
    "supply-flow": "node scripts/supply-flow.js",
    "oi-evaluate": "cd outreach-intelligence && .venv/bin/python -m carelink_oi.evaluate",
    "oi-test": "cd outreach-intelligence && .venv/bin/python -m pytest -q"
  },
  "devDependencies": {
    "cht-conf": "6.6.1",
    "cht-conf-test-harness": "5.0.4"
  }
}
